{
  "name": "undiscord",
  "nameFull": "Undiscord",
  "version": "5.2.6-Void-fix",
  "type": "module",
  "description": "Delete all messages in a Discord channel or DM (Bulk deletion)",
  "userScript": {
    "namespace": "https://github.com/victornpb/deleteDiscordMessages",
    "match": [
      "https://*.discord.com/app",
      "https://*.discord.com/channels/*",
      "https://*.discord.com/login"
    ],
    "icon": "https://victornpb.github.io/undiscord/images/icon128.png",
    "downloadURL": "https://raw.githubusercontent.com/Void-Man-1/undiscord-UI-fix/master/deleteDiscordMessages.user.js",
    "updateURL": "https://raw.githubusercontent.com/Void-Man-1/undiscord-UI-fix/master/deleteDiscordMessages.user.js",
    "contributionURL": "https://www.buymeacoffee.com/vitim",
    "run-at": "document-idle",
    "grant": "none",
    "attribution": "Original project (https://github.com/victornpb/undiscord)"
  },
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Void-Man-1/undiscord-UI-fix.git"
  },
  "bugs": {
    "url": "https://github.com/Void-Man-1/undiscord-UI-fix/issues"
  },
  "homepage": "https://github.com/Void-Man-1/undiscord-UI-fix",
  "author": "victornpb",
  "main": "deleteDiscordMessages.user.js",
  "scripts": {
    "start": "npm run watch",
    "build": "rollup -c",
    "watch": "rollup -c -w",
    "test": "npm run lint && npm run test:unit && npm run build && npm run test:ui",
    "test:unit": "node --test test/helpers.test.js test/core.test.js",
    "test:ui": "node --test test/ui.test.js",
    "lint": "eslint .",
    "lint:fix": "eslint src --fix",
    "version": "npm run build"
  },
  "files": [
    "deleteDiscordMessages.user.js",
    "src"
  ],
  "keywords": [
    "delete",
    "messages",
    "discord",
    "wipe",
    "purge",
    "clean",
    "bulk"
  ],
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@rollup/plugin-commonjs": "^29.0.3",
    "@rollup/plugin-json": "^6.1.0",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/pluginutils": "^5.4.0",
    "eslint": "^10.9.0",
    "globals": "^17.11.0",
    "jsdom": "^30.0.1",
    "rollup": "^4.62.5",
    "rollup-plugin-baked-env": "^1.0.1",
    "rollup-plugin-banner2": "^1.3.1",
    "rollup-plugin-serve": "^3.0.0",
    "tiny-dedent": "^1.0.2"
  }
}
